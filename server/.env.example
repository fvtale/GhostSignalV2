# Copy to .env (or set in your host's dashboard). Never commit real keys.
PORT=8080
# Listen on this address only, e.g. 127.0.0.1 behind a reverse proxy on the same machine.
HOST=
# 1 when a reverse proxy on this machine (Caddy, nginx) is the only way in: the per-address
# limits then use the address it puts last in X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=
EVENT_TOKEN=change-me-shared-with-every-phone
OPERATOR_TOKEN=change-me-operator-only
# Optional: let DataRail accounts with admin rights sign in to /admin. The DataRail account
# service's API, e.g. https://<host>/storage/api. The operator token works either way.
DATARAIL_API=
# GhostSignal accounts with these emails are admins (comma-separated). Create the account on
# /account first, then sign in to /admin with it. Admins can make other accounts admins.
ADMIN_EMAILS=
# Premium. The payment link and price can also be set on the admin page (Players tab).
# A Stripe Payment Link (https://buy.stripe.com/...) or a Lemon Squeezy checkout link.
PAYMENT_LINK_URL=
PREMIUM_PRICE_LABEL=
# Optional: where premium players manage or cancel (e.g. a Stripe customer portal login link).
MANAGE_BILLING_URL=
# Sign-ups and sign-ins allowed per address per minute. A venue's Wi-Fi puts everyone behind one
# address, so these default high (30 and 60); lower them for a public server.
SIGNUPS_PER_MINUTE=
LOGINS_PER_MINUTE=
# Webhook signing secrets, so a payment switches premium on by itself. Endpoints:
# <server>/v1/billing/stripe and <server>/v1/billing/lemonsqueezy
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 at low effort. claude-haiku-5-5 is the fastest option.
NPC_MODEL=claude-opus-5-5
NPC_EFFORT=low
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE=
# Per-character voices (or set voice.ttsVoice in the mission file):
# ELEVENLABS_VOICE_VESPER=
# ELEVENLABS_VOICE_SMARTSPECS=
# ELEVENLABS_VOICE_ARCHIVIST=
# ELEVENLABS_VOICE_KILO=
# ELEVENLABS_VOICE_MARI=
# ELEVENLABS_VOICE_HUSH=
DATA_DIR=./data
